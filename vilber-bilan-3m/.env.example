# Copier en .env et renseigner. .env est ignore par git.
# Charger avec :  set -a && source .env && set +a

# --- Google Search Console -------------------------------------------------
# JSON OAuth client_secret (compte qui a acces a la propriete) OU compte de service.
GSC_CREDENTIALS=/chemin/vers/gsc-credentials.json
# Propriete Search Console. Domaine : "sc-domain:vilber.com". URL : "https://vilber.com/"
GSC_SITE_URL=sc-domain:vilber.com
# Optionnel : ou stocker le token OAuth apres le premier consentement.
# GSC_TOKEN=./data/raw/search_console/_token.json

# --- Google Analytics 4 ----------------------------------------------------
GA4_CREDENTIALS=/chemin/vers/ga4-service-account.json
GA4_PROPERTY_ID=123456789

# --- SEMrush ---------------------------------------------------------------
# Si absente : exporter manuellement en CSV dans data/raw/semrush/manual/
# puis lancer  python scripts/extract_semrush.py --from-csv
SEMRUSH_API_KEY=

# --- Microsoft Clarity -----------------------------------------------------
# Ne couvre que les 3 derniers jours. T0 et T1 passent forcement par un export CSV
# depose dans data/raw/clarity/manual/<periode>__<dataset>.csv
CLARITY_API_TOKEN=

# --- Webflow ---------------------------------------------------------------
# ATTENTION : doit etre un token de l'espace Webflow de VILBER, pas du notre.
# Le site "Vilber" present dans l'espace Studio Visuweb est une copie de dev
# sans soumissions (cf. docs/ECARTS-BRIEF.md § 8).
WEBFLOW_TOKEN=
# WEBFLOW_SITE_ID=          # optionnel : sinon resolu via le domaine vilber.com
